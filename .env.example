# Pasta das sessões, listas e sorteios. O Vite e o tsx watch ignoram data/, .wwebjs_auth e .wwebjs_cache.
DATA_DIR=data

# Porta da API local (o Vite encaminha /api para cá).
PORT=38471

# Porta da interface. Abra http://127.0.0.1:38472
CLIENT_PORT=38472

# Chrome ou Edge já instalado. No Windows, se ficar vazio, o app procura os caminhos padrão.
# Ex.: C:\Program Files\Google\Chrome\Application\chrome.exe
CHROME_PATH=

# Se o Puppeteer precisar baixar o Chromium, use um disco com espaço (o C: pode estar cheio).
# Defina isto no terminal ANTES do npm install, se for baixar o navegador.
# PUPPETEER_CACHE_DIR=E:\puppeteer-cache

# Pausa depois de cada pessoa, em milissegundos (mínimo efetivo 2000).
SEND_DELAY_MS=3000

# Espera depois do envio, antes de apagar para mim.
DELETE_FOR_ME_DELAY_MS=1500

# Quanto esperar o recibo do envio e a confirmação do apagar para mim.
ACK_TIMEOUT_MS=6000
DELETE_CONFIRM_TIMEOUT_MS=8000

# E-mail da sessão que o MCP local usa. A API (npm run dev) precisa estar no ar.
# MCP_EMAIL=ada@exemplo.test
# MCP_API_BASE=http://127.0.0.1:38471
# MCP HTTP é opcional, só em 127.0.0.1, e exige um bearer. Cada POST é independente (sem mcp-session-id).
# MCP_HTTP_PORT=38473
# MCP_TOKEN=

# silent | warn | info | debug
# info mostra jid, id da mensagem e se o apagar foi confirmado.
# debug é mais verboso. O texto da mensagem e o nome sorteado não entram no log.
LOG_LEVEL=warn
