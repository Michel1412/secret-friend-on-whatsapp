{
  "name": "secret-friend-on-whatsapp",
  "private": true,
  "version": "1.0.0",
  "license": "AGPL-3.0-only",
  "author": "Michel Bocchi Junior",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,blue \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "tsx watch --exclude \"./data/**\" --exclude \"**/.wwebjs_auth/**\" --exclude \"**/.wwebjs_cache/**\" server/src/index.ts",
    "dev:web": "vite --host 0.0.0.0 --strictPort",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "build": "vite build",
    "start": "tsx server/src/index.ts",
    "mcp": "tsx server/src/mcp.ts"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.2.8",
    "@fontsource/outfit": "^5.2.8",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@testing-library/dom": "^10.4.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "lucide-react": "^0.554.0",
    "pino": "^9.14.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.4.0",
    "whatsapp-web.js": "1.34.8",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.12",
    "concurrently": "^9.2.1",
    "happy-dom": "^20.0.10",
    "supertest": "^7.3.2",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  }
}
